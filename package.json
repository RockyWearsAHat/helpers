{
  "name": "@rockywearsahat/helpers",
  "version": "0.5.2",
  "description": "Native AI-agent tooling (MCP server + CLI) as a single binary — Node-free runtime.",
  "license": "MIT",
  "preferGlobal": true,
  "homepage": "https://github.com/RockyWearsAHat/helpers",
  "bugs": {
    "url": "https://github.com/RockyWearsAHat/helpers/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RockyWearsAHat/helpers.git"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "git",
    "copilot",
    "mcp",
    "vscode",
    "automation"
  ],
  "bin": {
    "helpers": "bin/helpers.cjs"
  },
  "scripts": {
    "test": "node test/package-json.test.js",
    "setup-git-hooks": "node scripts/setup-git-hooks.cjs",
    "postinstall": "node scripts/npm-postinstall.cjs && npm run setup-git-hooks"
  },
  "files": [
    "bin/helpers.cjs",
    "scripts/npm-postinstall.cjs",
    "scripts/setup-git-hooks.cjs",
    "README.md",
    "VERSION"
  ],
  "devDependencies": {
    "eslint": "^10.9.1"
  }
}
