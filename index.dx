::code id=cap-mcp-answers lang=bash run
set -euo pipefail
# Find the helpers-native binary portably
BINARY=""
if [ -x "helpers-native" ]; then
  BINARY="./helpers-native"
elif [ -x "native/target/release/helpers-native" ]; then
  BINARY="native/target/release/helpers-native"
elif [ -x "native/target/release/helpers-native.exe" ]; then
  BINARY="native/target/release/helpers-native.exe"
elif command -v helpers-native >/dev/null 2>&1; then
  BINARY="helpers-native"
else
  echo "FAIL: helpers-native binary not found in current dir, native/target/release, or PATH"
  exit 1
fi

# Test MCP call
if echo '{}' | "$BINARY" call list_workspace_tools 2>&1 | grep -qE '"type"|"name"|No project'; then
  echo "✓ MCP tools callable"
else
  echo "FAIL: no MCP response"
  exit 1
fi
::end

