::code id=cap-full-build lang=bash run reads=native writes=native/target
set -euo pipefail
cd native
T=$(command -v gtimeout || command -v timeout || true)
[ -n "$T" ] || { echo "FAIL: timeout command not found"; exit 1; }
# On Windows with GNU toolchain, clean stale MSVC build artifacts
if [[ "${OSTYPE:-}" == MINGW* ]]; then
  rm -rf target 2>/dev/null || true
fi
$T 300 cargo +stable build --release --bins -q 2>&1 && echo "✓ release build complete" || { echo "FAIL: release build"; exit 1; }
::end

